{
  "lastChangelogVersion": "0.84.2",
  "packages": [
    "npm:pi-web-access",
    "npm:@ff-labs/pi-fff",
    "npm:@spences10/pi-skills",
    "npm:pi-tool-display",
    "npm:pi-anycopy",
    "npm:@narumitw/pi-btw",
    "npm:@juicesharp/rpiv-ask-user-question",
    "npm:@howaboua/pi-codex-conversion",
    "npm:@plannotator/pi-extension",
    "npm:@gotgenes/pi-permission-system",
    {
      "source": "npm:pi-subagents",
      "extensions": [
        "-index.ts"
      ]
    },
    "npm:pi-condense",
    "npm:pi-dynamic-workflows",
    "npm:pi-extmgr"
  ],
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-5.6-sol",
  "defaultThinkingLevel": "high",
  "theme": "dark",
  "contextPrune": {
    "enabled": true,
    "showPruneStatusLine": true,
    "summarizerModel": "default",
    "summarizerThinking": "default",
    "pruneOn": "agent-message",
    "batchingMode": "turn",
    "quietOversizedSkips": false,
    "minBatchChars": 1000,
    "recoveryGraceTurns": 3,
    "summarizerIdleTimeoutMs": 20000,
    "summarizerMaxTimeoutMs": 180000,
    "protectedTools": [],
    "protectedPaths": [
      "**/skills/**/*.md"
    ],
    "chainCompression": {
      "enabled": true,
      "rollingWindow": 3,
      "stripFinalAssistantThinking": true,
      "fuseRangeSummary": true
    },
    "purgeErrors": {
      "enabled": true,
      "cooldownTurns": 2,
      "minArgChars": 500
    },
    "dedupByContentHash": true,
    "autoBudgetThreshold": null,
    "spillThreshold": 65536,
    "spillPreviewBytes": 2048,
    "budgetTurnDelta": null
  },
  "hideThinkingBlock": true
}
