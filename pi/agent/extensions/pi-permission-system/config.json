{
  "$schema": "https://raw.githubusercontent.com/gotgenes/pi-permission-system/main/schemas/permissions.schema.json",

  "permission": {
    "*": "ask",
    "read": "allow",
    "grep": "allow",
    "find": "allow",
    "write": "ask",
    "edit": "ask",
    "bash": {
      "rm -rf *": "deny"
    },
    "fffind": "allow",
    "ffgrep": "allow",
    "fff-multi-grep": "allow",
    "external_directory": "ask",
    "cursor_ask_question": "allow",
    "exec_command": "allow",
    "ask_user_question": "allow",
    "subagent": "allow",
    "write_stdin": "allow",
    "subagent_wait": "allow",
    "subagent_supervisor": "allow"
  }
}
