{
  "lastChangelogVersion": "1.1.0",
  "packages": [
    "npm:pi-web-access",
    "npm:@ff-labs/pi-fff",
    "npm:@spences10/pi-skills",
    "npm:pi-tool-display",
    "npm:pi-anycopy",
    "npm:@narumitw/pi-btw",
    "npm:@juicesharp/rpiv-ask-user-question",
    "npm:@howaboua/pi-codex-conversion",
    "npm:@plannotator/pi-extension",
    "npm:pi-subagents",
    "npm:pi-condense",
    "npm:@juicesharp/rpiv-todo",
    "npm:pi-extmgr",
    "npm:pi-hermes-memory",
    {
      "source": "~/.config/nono/packages/nolabs-ai/pi"
    }
  ],
  "defaultProvider": "openai-codex",
  "defaultModel": "openai-codex/gpt-6.1-luna",
  "defaultThinkingLevel": "high",
  "theme": "dark",
  "contextPrune": {
    "enabled": true,
    "showPruneStatusLine": true,
    "summarizerModel": "openai-codex/gpt-6-luna",
    "summarizerThinking": "default",
    "pruneOn": "agent-message",
    "batchingMode": "turn",
    "quietOversizedSkips": false,
    "minBatchChars": 1000,
    "recoveryGraceTurns": 3,
    "summarizerIdleTimeoutMs": 20000,
    "summarizerMaxTimeoutMs": 180000,
    "protectedTools": [],
    "protectedPaths": [
      "**/skills/**/*.md"
    ],
    "chainCompression": {
      "enabled": true,
      "rollingWindow": 3,
      "stripFinalAssistantThinking": true,
      "fuseRangeSummary": true
    },
    "purgeErrors": {
      "enabled": true,
      "cooldownTurns": 2,
      "minArgChars": 500
    },
    "dedupByContentHash": true,
    "autoBudgetThreshold": null,
    "spillThreshold": 65536,
    "spillPreviewBytes": 2048,
    "budgetTurnDelta": null
  }
}
